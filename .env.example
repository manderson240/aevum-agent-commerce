# Preferred: create an encrypted Foundry keystore instead of placing a private key in .env:
#   cast wallet new aevum-deployer
# Optional fallback private key for headless scripts:
PRIVATE_KEY=

# QDay Aevum Testnet (Chain ID 44005, Shanghai EVM)
AEVUM_RPC_URL=https://rpc-test.qday.info
AEVUM_CHAIN_ID=44005

# Real tUSD8 stablecoin on QDay Aevum Testnet (6 decimals)
TUSD8_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483

# Set after deploying ERC8004AgentRegistry (or leave empty to deploy MockERC8004Registry)
ERC8004_REGISTRY_ADDRESS=
VERIFIER_ORACLE=
REQUIRE_VERIFIED_PAYEE=true
ESCROW_ADDRESS=
